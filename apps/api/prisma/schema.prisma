generator client {
  provider = "prisma-client"
  output   = "../src/shared/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum ProblemDifficulty {
  EASY
  MEDIUM
  HARD
}

enum ProblemAvailability {
  AVAILABLE
  PAID_ONLY
  UNAVAILABLE
}

enum CatalogImportSource {
  CURATED
  LLM_GENERATED
}

enum CatalogReviewStatus {
  DRAFT
  APPROVED
  REJECTED
}

enum UserRole {
  USER
  ADMINISTRATOR
}

model UserProfile {
  id                      String                   @id @default(uuid()) @db.Uuid
  authSubject             String                   @unique @map("auth_subject") @db.Uuid
  role                    UserRole                 @default(USER)
  hidePaidProblems        Boolean                  @default(false) @map("hide_paid_problems")
  createdAt               DateTime                 @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt               DateTime                 @updatedAt @map("updated_at") @db.Timestamptz(3)
  dailyPlan               DailyPlan?
  practiceSettings        PracticeSettings?
  attempts                Attempt[]
  attemptAssessmentDrafts AttemptAssessmentDraft[]
  learnerGoals            LearnerGoal[]
  teachingPreferences     TeachingPreference[]
  conversationSummaries   ConversationSummary[]
  learnerMemories         LearnerMemory[]
  catalogImportBatches    CatalogImportBatch[]
  reviewedProblems        Problem[]                @relation("ProblemReviewedBy")
  publishedProblems       Problem[]                @relation("ProblemPublishedBy")

  @@map("user_profiles")
}

model PracticeSettings {
  userProfileId       String      @id @map("user_profile_id") @db.Uuid
  defaultAiModel      String      @default("gpt-5.4-mini") @map("default_ai_model") @db.VarChar(200)
  attemptTimerMinutes Int         @default(30) @map("attempt_timer_minutes") @db.SmallInt
  timeZone            String      @map("time_zone") @db.VarChar(100)
  resetMinutes        Int         @map("reset_minutes") @db.SmallInt
  dailyTarget         Int         @map("daily_target") @db.SmallInt
  highIntervalDays    Int         @map("high_interval_days") @db.SmallInt
  mediumIntervalDays  Int         @map("medium_interval_days") @db.SmallInt
  lowIntervalDays     Int         @map("low_interval_days") @db.SmallInt
  createdAt           DateTime    @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt           DateTime    @updatedAt @map("updated_at") @db.Timestamptz(3)
  userProfile         UserProfile @relation(fields: [userProfileId], references: [id], onDelete: Cascade)

  @@map("practice_settings")
}

model Problem {
  id                       String              @id @default(uuid()) @db.Uuid
  leetcodeId               Int                 @unique @map("leetcode_id")
  slug                     String              @unique @db.VarChar(255)
  title                    String              @db.VarChar(255)
  difficulty               ProblemDifficulty
  url                      String              @db.VarChar(500)
  availability             ProblemAvailability @default(AVAILABLE)
  reviewStatus             CatalogReviewStatus @default(DRAFT) @map("review_status")
  published                Boolean             @default(false)
  importBatchId            String?             @map("import_batch_id") @db.Uuid
  reviewedByUserProfileId  String?             @map("reviewed_by_user_profile_id") @db.Uuid
  reviewedAt               DateTime?           @map("reviewed_at") @db.Timestamptz(3)
  publishedByUserProfileId String?             @map("published_by_user_profile_id") @db.Uuid
  publishedAt              DateTime?           @map("published_at") @db.Timestamptz(3)
  createdAt                DateTime            @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt                DateTime            @updatedAt @map("updated_at") @db.Timestamptz(3)
  importBatch              CatalogImportBatch? @relation(fields: [importBatchId], references: [id], onDelete: SetNull)
  reviewedBy               UserProfile?        @relation("ProblemReviewedBy", fields: [reviewedByUserProfileId], references: [id], onDelete: Restrict)
  publishedBy              UserProfile?        @relation("ProblemPublishedBy", fields: [publishedByUserProfileId], references: [id], onDelete: Restrict)
  problemPatterns          ProblemPattern[]
  planItems                DailyPlanItem[]
  attempts                 Attempt[]

  @@index([importBatchId])
  @@index([reviewedByUserProfileId])
  @@index([publishedByUserProfileId])
  @@map("problems")
}

model CatalogImportBatch {
  id                     String              @id @default(uuid()) @db.Uuid
  formatVersion          Int                 @map("format_version") @db.SmallInt
  sourceKind             CatalogImportSource @map("source_kind")
  sourceName             String              @map("source_name") @db.VarChar(255)
  createdByUserProfileId String              @map("created_by_user_profile_id") @db.Uuid
  createdAt              DateTime            @default(now()) @map("created_at") @db.Timestamptz(3)
  createdBy              UserProfile         @relation(fields: [createdByUserProfileId], references: [id], onDelete: Restrict)
  problems               Problem[]

  @@index([createdByUserProfileId])
  @@map("catalog_import_batches")
}

model Pattern {
  id              String               @id @default(uuid()) @db.Uuid
  name            String               @unique @db.VarChar(100)
  createdAt       DateTime             @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime             @updatedAt @map("updated_at") @db.Timestamptz(3)
  transfers       TransferObligation[]
  aliases         PatternAlias[]
  problemPatterns ProblemPattern[]

  @@map("patterns")
}

model PatternAlias {
  id        String  @id @default(uuid()) @db.Uuid
  patternId String  @map("pattern_id") @db.Uuid
  name      String  @unique @db.VarChar(100)
  pattern   Pattern @relation(fields: [patternId], references: [id], onDelete: Cascade)

  @@index([patternId])
  @@map("pattern_aliases")
}

model ProblemPattern {
  problemId String  @map("problem_id") @db.Uuid
  patternId String  @map("pattern_id") @db.Uuid
  problem   Problem @relation(fields: [problemId], references: [id], onDelete: Cascade)
  pattern   Pattern @relation(fields: [patternId], references: [id], onDelete: Cascade)

  @@id([problemId, patternId])
  @@index([patternId])
  @@map("problem_patterns")
}

enum AttemptType {
  FRESH
  REDO
}

enum AttemptOutcome {
  INDEPENDENT
  ASSISTED
  GAVE_UP
  INCOMPLETE
}

enum AttemptConfidence {
  CONFIDENT
  SHAKY
}

enum AttemptOptimality {
  OPTIMAL
  SUBOPTIMAL
  UNKNOWN
}

enum AssistanceType {
  CLARIFICATION
  CONCEPTUAL_HINT
  DEBUGGING
  OPTIMIZATION
  SOLUTION_REVIEW
}

enum AssistanceSource {
  SELF_REPORTED
  LEETCODE_SOLUTION
  INTEGRATED_AI
}

model Attempt {
  id                       String                  @id @default(uuid()) @db.Uuid
  userProfileId            String                  @map("user_profile_id") @db.Uuid
  problemId                String                  @map("problem_id") @db.Uuid
  type                     AttemptType
  practiceDate             DateTime                @map("practice_date") @db.Date
  startedAt                DateTime                @map("started_at") @db.Timestamptz(3)
  timerEndsAt              DateTime                @map("timer_ends_at") @db.Timestamptz(3)
  timerPausedAt            DateTime?               @map("timer_paused_at") @db.Timestamptz(3)
  timerSkippedAt           DateTime?               @map("timer_skipped_at") @db.Timestamptz(3)
  confirmedAt              DateTime?               @map("confirmed_at") @db.Timestamptz(3)
  solutionReviewedAt       DateTime?               @map("solution_reviewed_at") @db.Timestamptz(3)
  outcome                  AttemptOutcome?
  confidence               AttemptConfidence?
  optimality               AttemptOptimality?
  timeSpentSeconds         Int?                    @map("time_spent_seconds")
  approach                 String?                 @db.VarChar(1000)
  notes                    String?                 @db.VarChar(5000)
  reproducedFromMemory     Boolean?                @map("reproduced_from_memory")
  nextAction               Json?                   @map("next_action")
  planItems                DailyPlanItem[]
  transfersCreated         TransferObligation[]    @relation("TransferSource")
  transferAttempt          TransferObligation?     @relation("TransferAttempt")
  assistance               AssistanceEvent[]
  review                   ReviewObligation?
  summary                  AttemptSummary?
  assessmentDraft          AttemptAssessmentDraft?
  conversationSummaries    ConversationSummary[]
  memoryEvidence           LearnerMemoryEvidence[] @relation("AttemptEvidence")
  assistanceMemoryEvidence LearnerMemoryEvidence[] @relation("AssistanceAttemptEvidence")
  userProfile              UserProfile             @relation(fields: [userProfileId], references: [id], onDelete: Cascade)
  problem                  Problem                 @relation(fields: [problemId], references: [id], onDelete: Restrict)

  @@unique([id, userProfileId])
  @@index([userProfileId, problemId])
  @@index([problemId])
  @@map("attempts")
}

model AssistanceEvent {
  id             String                  @id @default(uuid()) @db.Uuid
  attemptId      String                  @map("attempt_id") @db.Uuid
  type           AssistanceType
  hintLevel      Int?                    @map("hint_level") @db.SmallInt
  source         AssistanceSource
  recordedAt     DateTime                @default(now()) @map("recorded_at") @db.Timestamptz(3)
  attempt        Attempt                 @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  memoryEvidence LearnerMemoryEvidence[]

  @@unique([id, attemptId])
  @@index([attemptId])
  @@map("assistance_events")
}

enum ReviewUrgency {
  LOW
  MEDIUM
  HIGH
}

model ReviewObligation {
  sourceAttemptId  String        @id @map("source_attempt_id") @db.Uuid
  resolvedAt       DateTime?     @map("resolved_at") @db.Timestamptz(3)
  urgency          ReviewUrgency
  generatedDueDate DateTime      @map("generated_due_date") @db.Date
  manualDueDate    DateTime?     @map("manual_due_date") @db.Date
  sourceAttempt    Attempt       @relation(fields: [sourceAttemptId], references: [id], onDelete: Cascade)

  @@map("review_obligations")
}

model TransferObligation {
  id                    String          @id @default(uuid()) @db.Uuid
  sourceAttemptId       String          @map("source_attempt_id") @db.Uuid
  patternId             String          @map("pattern_id") @db.Uuid
  generatedEligibleDate DateTime        @map("generated_eligible_date") @db.Date
  manualEligibleDate    DateTime?       @map("manual_eligible_date") @db.Date
  attemptId             String?         @unique @map("attempt_id") @db.Uuid
  resolvedAt            DateTime?       @map("resolved_at") @db.Timestamptz(3)
  sourceAttempt         Attempt         @relation("TransferSource", fields: [sourceAttemptId], references: [id], onDelete: Cascade)
  pattern               Pattern         @relation(fields: [patternId], references: [id], onDelete: Restrict)
  attempt               Attempt?        @relation("TransferAttempt", fields: [attemptId], references: [id], onDelete: SetNull)
  planItems             DailyPlanItem[]

  @@index([sourceAttemptId])
  @@index([patternId])
  @@map("transfer_obligations")
}

model DailyPlan {
  userProfileId String          @id @map("user_profile_id") @db.Uuid
  practiceDate  DateTime        @map("practice_date") @db.Date
  target        Int             @db.SmallInt
  timeZone      String          @map("time_zone") @db.VarChar(100)
  resetMinutes  Int             @map("reset_minutes") @db.SmallInt
  userProfile   UserProfile     @relation(fields: [userProfileId], references: [id], onDelete: Cascade)
  items         DailyPlanItem[]

  @@map("daily_plans")
}

model DailyPlanItem {
  id            String              @id @default(uuid()) @db.Uuid
  userProfileId String              @map("user_profile_id") @db.Uuid
  position      Int                 @db.SmallInt
  problemId     String              @map("problem_id") @db.Uuid
  kind          String              @db.VarChar(20)
  reason        String              @db.VarChar(30)
  attemptId     String?             @map("attempt_id") @db.Uuid
  transferId    String?             @map("transfer_id") @db.Uuid
  plan          DailyPlan           @relation(fields: [userProfileId], references: [userProfileId], onDelete: Cascade)
  problem       Problem             @relation(fields: [problemId], references: [id], onDelete: Restrict)
  attempt       Attempt?            @relation(fields: [attemptId], references: [id], onDelete: SetNull)
  transfer      TransferObligation? @relation(fields: [transferId], references: [id], onDelete: SetNull)

  @@unique([userProfileId, position])
  @@unique([userProfileId, problemId])
  @@index([problemId])
  @@index([attemptId])
  @@index([transferId])
  @@map("daily_plan_items")
}

enum LearnerGoalState {
  ACTIVE
  COMPLETED
  ARCHIVED
}

enum ConversationMode {
  COACH
  ATTEMPT_TUTOR
}

enum MemoryLifecycleState {
  ACTIVE
  IMPROVING
  RESOLVED
}

enum MemoryApprovalState {
  PENDING
  APPROVED
  REJECTED
}

model LearnerGoal {
  id             String                  @id @default(uuid()) @db.Uuid
  userProfileId  String                  @map("user_profile_id") @db.Uuid
  target         String                  @db.VarChar(1000)
  priority       Int                     @default(0)
  state          LearnerGoalState        @default(ACTIVE)
  createdAt      DateTime                @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime                @updatedAt @map("updated_at") @db.Timestamptz(3)
  userProfile    UserProfile             @relation(fields: [userProfileId], references: [id], onDelete: Cascade)
  memoryEvidence LearnerMemoryEvidence[]

  @@unique([id, userProfileId])
  @@index([userProfileId, state])
  @@map("learner_goals")
}

model TeachingPreference {
  id             String                  @id @default(uuid()) @db.Uuid
  userProfileId  String                  @map("user_profile_id") @db.Uuid
  preference     String                  @db.VarChar(1000)
  createdAt      DateTime                @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime                @updatedAt @map("updated_at") @db.Timestamptz(3)
  userProfile    UserProfile             @relation(fields: [userProfileId], references: [id], onDelete: Cascade)
  memoryEvidence LearnerMemoryEvidence[]

  @@unique([id, userProfileId])
  @@index([userProfileId])
  @@map("teaching_preferences")
}

model AttemptSummary {
  attemptId          String                  @id @map("attempt_id") @db.Uuid
  userProfileId      String                  @map("user_profile_id") @db.Uuid
  approach           String?                 @db.VarChar(1000)
  stuckPoint         String?                 @map("stuck_point") @db.VarChar(1000)
  misconception      String?                 @db.VarChar(1000)
  assistance         String?                 @db.VarChar(1000)
  progressTrigger    String?                 @map("progress_trigger") @db.VarChar(1000)
  finalUnderstanding String?                 @map("final_understanding") @db.VarChar(1000)
  nextTeachingAction String?                 @map("next_teaching_action") @db.VarChar(1000)
  reviewedAt         DateTime?               @map("reviewed_at") @db.Timestamptz(3)
  createdAt          DateTime                @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt          DateTime                @updatedAt @map("updated_at") @db.Timestamptz(3)
  attempt            Attempt                 @relation(fields: [attemptId, userProfileId], references: [id, userProfileId], onDelete: Cascade)
  memoryEvidence     LearnerMemoryEvidence[]

  @@unique([attemptId, userProfileId])
  @@index([userProfileId])
  @@map("attempt_summaries")
}

model AttemptAssessmentDraft {
  id                   String             @id @default(uuid()) @db.Uuid
  attemptId            String             @unique @map("attempt_id") @db.Uuid
  userProfileId        String             @map("user_profile_id") @db.Uuid
  outcome              AttemptOutcome
  confidence           AttemptConfidence?
  optimality           AttemptOptimality?
  timeSpentSeconds     Int?               @map("time_spent_seconds")
  approach             String?            @db.VarChar(1000)
  notes                String?            @db.VarChar(1000)
  reproducedFromMemory Boolean?           @map("reproduced_from_memory")
  summary              Json?
  evidence             String[]
  createdAt            DateTime           @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt            DateTime           @updatedAt @map("updated_at") @db.Timestamptz(3)
  attempt              Attempt            @relation(fields: [attemptId, userProfileId], references: [id, userProfileId], onDelete: Cascade)
  userProfile          UserProfile        @relation(fields: [userProfileId], references: [id], onDelete: Cascade)

  @@unique([id, userProfileId])
  @@unique([attemptId, userProfileId])
  @@index([userProfileId])
  @@map("attempt_assessment_drafts")
}

model ConversationSummary {
  id               String                  @id @default(uuid()) @db.Uuid
  userProfileId    String                  @map("user_profile_id") @db.Uuid
  mode             ConversationMode
  attemptId        String?                 @map("attempt_id") @db.Uuid
  topics           String                  @db.VarChar(1000)
  learningProgress String?                 @map("learning_progress") @db.VarChar(1000)
  nextSteps        String?                 @map("next_steps") @db.VarChar(1000)
  createdAt        DateTime                @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime                @updatedAt @map("updated_at") @db.Timestamptz(3)
  userProfile      UserProfile             @relation(fields: [userProfileId], references: [id], onDelete: Cascade)
  attempt          Attempt?                @relation(fields: [attemptId, userProfileId], references: [id, userProfileId], onDelete: Cascade)
  memoryEvidence   LearnerMemoryEvidence[]

  @@unique([id, userProfileId])
  @@index([userProfileId, mode, updatedAt])
  @@index([attemptId, userProfileId])
  @@map("conversation_summaries")
}

model LearnerMemory {
  id             String                  @id @default(uuid()) @db.Uuid
  userProfileId  String                  @map("user_profile_id") @db.Uuid
  category       String                  @db.VarChar(100)
  content        String                  @db.VarChar(1000)
  confidence     Float
  lastObservedAt DateTime                @map("last_observed_at") @db.Timestamptz(3)
  lifecycleState MemoryLifecycleState    @default(ACTIVE) @map("lifecycle_state")
  approvalState  MemoryApprovalState     @default(PENDING) @map("approval_state")
  reviewedAt     DateTime?               @map("reviewed_at") @db.Timestamptz(3)
  createdAt      DateTime                @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime                @updatedAt @map("updated_at") @db.Timestamptz(3)
  userProfile    UserProfile             @relation(fields: [userProfileId], references: [id], onDelete: Cascade)
  evidence       LearnerMemoryEvidence[]

  @@unique([id, userProfileId])
  @@index([userProfileId, approvalState, lifecycleState])
  @@map("learner_memories")
}

model LearnerMemoryEvidence {
  id                    String               @id @default(uuid()) @db.Uuid
  userProfileId         String               @map("user_profile_id") @db.Uuid
  memoryId              String               @map("memory_id") @db.Uuid
  learnerGoalId         String?              @map("learner_goal_id") @db.Uuid
  teachingPreferenceId  String?              @map("teaching_preference_id") @db.Uuid
  attemptId             String?              @map("attempt_id") @db.Uuid
  assistanceEventId     String?              @map("assistance_event_id") @db.Uuid
  assistanceAttemptId   String?              @map("assistance_attempt_id") @db.Uuid
  attemptSummaryId      String?              @map("attempt_summary_id") @db.Uuid
  conversationSummaryId String?              @map("conversation_summary_id") @db.Uuid
  createdAt             DateTime             @default(now()) @map("created_at") @db.Timestamptz(3)
  memory                LearnerMemory        @relation(fields: [memoryId, userProfileId], references: [id, userProfileId], onDelete: Cascade)
  learnerGoal           LearnerGoal?         @relation(fields: [learnerGoalId, userProfileId], references: [id, userProfileId], onDelete: Cascade)
  teachingPreference    TeachingPreference?  @relation(fields: [teachingPreferenceId, userProfileId], references: [id, userProfileId], onDelete: Cascade)
  attempt               Attempt?             @relation("AttemptEvidence", fields: [attemptId, userProfileId], references: [id, userProfileId], onDelete: Cascade)
  assistanceEvent       AssistanceEvent?     @relation(fields: [assistanceEventId, assistanceAttemptId], references: [id, attemptId], onDelete: Cascade)
  assistanceAttempt     Attempt?             @relation("AssistanceAttemptEvidence", fields: [assistanceAttemptId, userProfileId], references: [id, userProfileId], onDelete: Cascade)
  attemptSummary        AttemptSummary?      @relation(fields: [attemptSummaryId, userProfileId], references: [attemptId, userProfileId], onDelete: Cascade)
  conversationSummary   ConversationSummary? @relation(fields: [conversationSummaryId, userProfileId], references: [id, userProfileId], onDelete: Cascade)

  @@index([memoryId, userProfileId])
  @@index([learnerGoalId, userProfileId])
  @@index([teachingPreferenceId, userProfileId])
  @@index([attemptId, userProfileId])
  @@index([assistanceEventId, assistanceAttemptId])
  @@index([assistanceAttemptId, userProfileId])
  @@index([attemptSummaryId, userProfileId])
  @@index([conversationSummaryId, userProfileId])
  @@map("learner_memory_evidence")
}
