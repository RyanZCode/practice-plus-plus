{
  "name": "@practice-plus-plus/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "dist/server.js",
  "scripts": {
    "prebuild": "pnpm --filter @practice-plus-plus/contracts build && pnpm run prisma:generate",
    "build": "tsc -p tsconfig.build.json",
    "dev": "pnpm run build && cross-env DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres node --env-file-if-exists=.env dist/server.js",
    "prisma:generate": "prisma generate",
    "prisma:migrate:deploy": "prisma migrate deploy",
    "prisma:migrate:dev": "cross-env DIRECT_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres prisma migrate dev",
    "prisma:migrate:local": "cross-env DIRECT_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres prisma migrate deploy",
    "prisma:migrate:status": "prisma migrate status",
    "pretypecheck": "pnpm run prisma:generate",
    "start": "node dist/server.js",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@practice-plus-plus/contracts": "workspace:*",
    "@prisma/adapter-pg": "7.10.0",
    "@prisma/client": "7.10.0",
    "@supabase/supabase-js": "2.114.0",
    "cors": "2.8.6",
    "express": "5.2.1",
    "pg": "8.16.3",
    "pino": "10.3.1",
    "pino-http": "11.0.0"
  },
  "devDependencies": {
    "@practice-plus-plus/config": "workspace:*",
    "@types/cors": "2.8.19",
    "@types/express": "5.0.6",
    "@types/node": "26.4.0",
    "@types/pg": "8.15.5",
    "cross-env": "10.1.0",
    "dotenv": "17.2.3",
    "prisma": "7.10.0"
  }
}
