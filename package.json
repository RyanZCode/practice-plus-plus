{
  "name": "practice-plus-plus",
  "version": "0.0.0",
  "private": true,
  "description": "Interview practice scheduling and analytics",
  "packageManager": "pnpm@11.24.0",
  "engines": {
    "node": "24.19.x",
    "pnpm": "11.24.x"
  },
  "scripts": {
    "build": "pnpm --recursive --if-present run build",
    "db:local:migrate": "pnpm --filter @practice-plus-plus/api prisma:migrate:local",
    "db:local:start": "supabase db start",
    "db:local:stop": "supabase stop",
    "format": "prettier --write .github apps packages package.json README.md pnpm-workspace.yaml *.config.mjs",
    "format:check": "prettier --check .github apps packages package.json README.md pnpm-workspace.yaml *.config.mjs",
    "lint": "eslint . --max-warnings 0",
    "pretest": "pnpm --filter @practice-plus-plus/contracts build && pnpm --filter @practice-plus-plus/scheduling build",
    "test": "vitest run --passWithNoTests",
    "pretypecheck": "pnpm --filter @practice-plus-plus/contracts build",
    "typecheck": "pnpm --recursive --if-present run typecheck"
  },
  "devDependencies": {
    "@practice-plus-plus/config": "workspace:*",
    "eslint": "10.9.1",
    "prettier": "3.9.6",
    "supabase": "2.116.0",
    "typescript": "6.0.3",
    "vitest": "4.1.11"
  }
}
